# InflexHub environment for docker compose (M0-7).
# Copy to .env and fill in real values. .env is git-ignored; never commit secrets.

# --- PostgreSQL (db service) ---
POSTGRES_USER=inflexhub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=inflexhub

# --- API + migrate service ---
# Host `db` resolves inside the compose network.
API_CONNECTION_STRING=Host=db;Port=5432;Database=inflexhub;Username=inflexhub;Password=change-me
ASPNETCORE_ENVIRONMENT=Development

# Shared secret between the site route handler and the API (ADR 0004).
# Random 32+ characters, same value as the API's Site__ApiKey.
SITE_API_KEY=change-me-random-32-plus-characters

# --- API (used from V1 rows; wired now so environments stay uniform) ---
# SHA-256 salt for hashed client IPs (NFR-6, V1-18).
PRIVACY_IP_HASH_SALT=
# CSV export key; export answers 404 while empty (BR-12, V1-27).
ADMIN_EXPORT_KEY=

# --- Site ---
# Public origin; inlined into the build (metadata base, sitemap) — V1-12.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
